# 项目根目录 .env —— 复制为 .env 后填写；.env 已被 git 忽略，不会上传。
# 插件启动时会自动加载本文件（也兼容 $DSH_HOME/.env 与 DSH_QQBOT_ENV_FILE）。

# ── QQ 官方机器人（channel=official 时需要；首次也可扫码自动写入）──
QQBOT_APPID=""
QQBOT_SECRET=""
# 私聊白名单（逗号分隔的用户 OpenID）
QQBOT_C2C_ALLOW=""

# ── DSH 模型 ──
DEEPSEEK_API_KEY=""

# ── 通道选择：official（官方机器人）或 onebot（NapCat 个人号）──
IM_QQBOT_CHANNEL="official"

# ── OneBot / NapCat（channel=onebot 时需要）──
ONEBOT_WS_URL="ws://127.0.0.1:3001"
ONEBOT_ACCESS_TOKEN=""
ONEBOT_SELF_ID=""
ONEBOT_WEBUI_URL=""
ONEBOT_WEBUI_TOKEN=""

# ── 记忆宫殿 ──
MEMORY_ENABLED="true"

# ── 情绪语音 TTS（BreezeBlue 官方 API 示例）──
VOICE_ENABLED="true"
VOICE_PROVIDER="breezeblue"
VOICE_EMOTIONAL="true"
BREEZE_VOICE_ID=""
BREEZE_API_KEY=""
BREEZE_URL="https://api.breeze.blue/v1"
BREEZE_MODEL="breeze-tts-2"
VOICE_API_KEY=""

# 语音输入转写（STT）：provider=dsh(DSH SenseVoice) | openai(兼容 /audio/transcriptions)
STT_ENABLED="true"
STT_PROVIDER="dsh"
STT_URL=""
STT_MODEL="whisper-1"
STT_API_KEY=""
STT_LANGUAGE=""
STT_FFMPEG_PATH=""

# 示例：硅基流动云端 ASR（STT_PROVIDER=openai 时，地址填 https://api.siliconflow.cn/v1，模型 FunAudioLLM/SenseVoiceSmall）
